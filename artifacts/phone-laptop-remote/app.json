{
  "expo": {
    "name": "Laptop Remote",
    "slug": "phone-laptop-remote",
    "version": "58.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "phone-laptop-remote",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0D1117",
      "resizeMode": "contain",
      "image": "./assets/images/icon.png"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Laptop Remote to recognize voice commands.",
        "NSMicrophoneUsageDescription": "Allow Laptop Remote to use the microphone for voice commands."
      }
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.laptopremote.phone"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
